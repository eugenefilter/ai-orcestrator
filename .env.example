QDRANT_URL=http://127.0.0.1:6333
DATA_DIR=./data
UI_PORT=8766
# Colon-separated absolute directories allowed for local-path ingestion.
ALLOWED_INGEST_DIRS=~/Documents/Ableton:~/Music
# Remote Script port of the Ableton MCP bridge, and the audio device that Live's output is routed to for renders.
ABLETON_PORT=9877
AUDIO_INPUT=BlackHole 2ch
